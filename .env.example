# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=quilore
POSTGRES_USER=quilore
POSTGRES_PASSWORD=quilore_dev_pass

# ─── MinIO (S3-compatible object storage) ────────────────────
MINIO_ROOT_USER=quilore_minio
MINIO_ROOT_PASSWORD=quilore_minio_secret
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=quilore-media

# ─── Spring Boot Backend ─────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
# Use a long random value in real environments — never commit real secrets.
JWT_SECRET=
# Base64-encoded 32-byte key for AES-GCM field encryption (see deploy/secrets/README.md).
DATA_ENCRYPTION_KEY=

# ─── TLS edge (optional) ─────────────────────────────────────
QUILORE_DOMAIN=localhost

# ─── FastAPI AI Service ──────────────────────────────────────
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_INTERNAL_TOKEN=
GROQ_API_KEY=
OPENROUTER_API_KEY=
HF_API_TOKEN=
NVIDIA_NIM_API_KEY=
# NIM model IDs (defaults match Quilore plan tier)
NIM_COACH_MODEL=meta/llama-3.1-70b-instruct
NIM_COACH_ALT=meta/llama-3.1-8b-instruct
NIM_ESCALATION_MODEL=meta/llama-3.1-70b-instruct
NIM_OCR_MODEL=meta/llama-3.2-90b-vision-instruct
NIM_EMBED_MODEL=nvidia/nv-embedqa-e5-v5
NIM_SAFETY_MODEL=meta/llama-guard-3-8b

# ─── Billing (UAT) ───────────────────────────────────────────
# When true, receipt matching QUILORE_MOCK_RECEIPT_TOKEN activates premium without store validation.
QUILORE_ALLOW_MOCK_RECEIPTS=false
QUILORE_MOCK_RECEIPT_TOKEN=UAT_MOCK_RECEIPT
