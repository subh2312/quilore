# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=quilore
POSTGRES_USER=quilore
POSTGRES_PASSWORD=quilore_dev_pass

# ─── MinIO (S3-compatible object storage) ────────────────────
MINIO_ROOT_USER=quilore_minio
MINIO_ROOT_PASSWORD=quilore_minio_secret
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=quilore-media

# ─── Spring Boot Backend ─────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
# Use a long random value in real environments — never commit real secrets.
JWT_SECRET=
# Base64-encoded 32-byte key for AES-GCM field encryption (see deploy/secrets/README.md).
DATA_ENCRYPTION_KEY=

# ─── TLS edge (optional) ─────────────────────────────────────
QUILORE_DOMAIN=localhost

# ─── FastAPI AI Service ──────────────────────────────────────
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_INTERNAL_TOKEN=
GROQ_API_KEY=
OPENROUTER_API_KEY=
HF_API_TOKEN=
NVIDIA_NIM_API_KEY=
# NIM model IDs (defaults match Quilore plan tier)
NIM_COACH_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NIM_COACH_ALT=google/gemma-4-31b-it
NIM_ESCALATION_MODEL=zhipuai/glm-5.2
NIM_OCR_MODEL=nvidia/nemotron-ocr-v2
NIM_EMBED_MODEL=nvidia/nemotron-3-embed-1b
NIM_SAFETY_MODEL=nvidia/nemotron-3.5-content-safety

# ─── Billing (UAT) ───────────────────────────────────────────
# When true, receipt matching QUILORE_MOCK_RECEIPT_TOKEN activates premium without store validation.
QUILORE_ALLOW_MOCK_RECEIPTS=false
QUILORE_MOCK_RECEIPT_TOKEN=UAT_MOCK_RECEIPT
