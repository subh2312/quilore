# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=quilore
POSTGRES_USER=quilore
POSTGRES_PASSWORD=quilore_dev_pass

# ─── MinIO (S3-compatible object storage) ────────────────────
MINIO_ROOT_USER=quilore_minio
MINIO_ROOT_PASSWORD=quilore_minio_secret
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=quilore-media

# ─── Spring Boot Backend ─────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
# Use a long random value in real environments — never commit real secrets.
JWT_SECRET=
# Base64-encoded 32-byte key for AES-GCM field encryption (see deploy/secrets/README.md).
DATA_ENCRYPTION_KEY=

# ─── TLS edge (optional) ─────────────────────────────────────
QUILORE_DOMAIN=localhost

# ─── FastAPI AI Service ──────────────────────────────────────
AI_SERVICE_PORT=8000
GROQ_API_KEY=
OPENROUTER_API_KEY=
HF_API_TOKEN=
NVIDIA_NIM_API_KEY=
