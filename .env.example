# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=quilore
POSTGRES_USER=quilore
POSTGRES_PASSWORD=quilore_dev_pass

# ─── MinIO (S3-compatible object storage) ────────────────────
MINIO_ROOT_USER=quilore_minio
MINIO_ROOT_PASSWORD=quilore_minio_secret
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=quilore-media

# ─── Spring Boot Backend ─────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
JWT_SECRET=change-me-in-production

# ─── FastAPI AI Service ──────────────────────────────────────
AI_SERVICE_PORT=8000
GROQ_API_KEY=
OPENROUTER_API_KEY=
HF_API_TOKEN=
NVIDIA_NIM_API_KEY=
