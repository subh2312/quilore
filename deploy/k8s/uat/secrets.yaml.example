# Copy to a local secrets.yaml (never commit real values), then:
#   kubectl apply -f secrets.yaml
apiVersion: v1
kind: Secret
metadata:
  name: quilore-secrets
  namespace: quilore
type: Opaque
stringData:
  POSTGRES_DB: quilore
  POSTGRES_USER: quilore
  POSTGRES_PASSWORD: "change-me"
  # Used by ai-service (must match POSTGRES_* above)
  DATABASE_URL: "postgresql://quilore:change-me@postgres:5432/quilore"
  MINIO_ROOT_USER: quilore_minio
  MINIO_ROOT_PASSWORD: "change-me-minio"
  JWT_SECRET: "change-me-32-plus-chars-minimum-please"
  DATA_ENCRYPTION_KEY: "change-me-base64-32-bytes===="
  AI_SERVICE_INTERNAL_TOKEN: "change-me-internal-token"
  QUILORE_ALLOW_MOCK_RECEIPTS: "true"
  QUILORE_MOCK_RECEIPT_TOKEN: "UAT_MOCK_RECEIPT"
  # Optional — leave empty until provided
  NVIDIA_NIM_API_KEY: ""
  GROQ_API_KEY: ""
  OPENROUTER_API_KEY: ""
  HF_API_TOKEN: ""
